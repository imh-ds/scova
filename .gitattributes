# Auto detect text files and perform LF normalization
* text=auto

# Archived evidence must round-trip byte for byte: provenance.json records a
# SHA-256 per file, and EOL normalization would invalidate every one of them.
validation_archive/cf-v9/release-evidence/** -text

# Completed SCOVA-CF final artifacts are copied from Actions downloads. Keep
# their byte representation stable so their recorded artifact checksums remain
# usable after a checkout.
evidence/presentation/scova-cf/**/*.json -text
